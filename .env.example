# Mẫu tên biến môi trường. Chép thành file .env.local rồi điền giá trị thật. Không đưa file có giá trị thật vào git.

# Gemini (chỉ dùng ở máy chủ)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_THINKING_LEVEL=
GEMINI_TIMEOUT_SECONDS=

# Supabase: địa chỉ dự án và khoá công khai (publishable) được gửi cho trình duyệt để đăng nhập ẩn danh.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Khoá bí mật (secret), chỉ dùng ở máy chủ để đếm lượt gọi AI. Không bao giờ thêm chữ NEXT_PUBLIC_ vào tên biến này.
SUPABASE_SECRET_KEY=

# Giới hạn số bài gửi cho AI mỗi ngày (số tạm). Bỏ trống thì dùng mặc định: 15 bài mỗi người, 150 bài cả app.
AI_GIOI_HAN_MOI_NGUOI_MOI_NGAY=
AI_GIOI_HAN_CA_APP_MOI_NGAY=

# Chỉ khi chạy `npm run dev`: 1 = dùng câu trả lời đã lưu trong samples/ket-qua-gemini.json, không gọi Gemini.
AI_DUNG_KET_QUA_MAU=
